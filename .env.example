# ---------------- 应用 ----------------
APP_NAME=游乐园排班系统
# 本地默认 SQLite（零依赖）；生产改为 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://schedule:CHANGE_ME@db:5432/schedule
DATABASE_URL=sqlite:///D:/workbuddy-projects/park-scheduling/data/schedule.db
SCHEDULE_DATA_DIR=D:/workbuddy-projects/park-scheduling/data

# ---------------- 安全 ----------------
# 生产必须替换：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-env
ACCESS_TOKEN_EXPIRE_MINUTES=720
# 首次启动创建的管理员（数据库已有账号时不会覆盖）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123456

# ---------------- 跨域（开发） ----------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------- 求解器 ----------------
SOLVER_MAX_TIME_SECONDS=20
SOLVER_RANDOM_SEED=20261105
ALLOW_GAP_DRAFT=true

# ---------------- 前端（构建时注入） ----------------
# 由后端同端口托管时留空；前后端分离部署时填写 API 地址
# NEXT_PUBLIC_API_BASE=https://schedule.example.com
